<!DOCTYPE html>
<html>
<%- include('partials/head', { title: 'Add product' }) %>
<body>
  <%- include('partials/header') %>
  <main>
    <h2>Add a product</h2>
    <form action="/products" method="POST" enctype="multipart/form-data">
      <label>Name <input type="text" name="name" required></label>
      <label>SKU <input type="text" name="sku"></label>
      <label>Category <input type="text" name="category"></label>
      <label>Unit price <input type="number" step="0.01" name="unit_price" required></label>
      <label>Quantity in stock <input type="number" name="quantity_in_stock" required></label>
      <label>Reorder level <input type="number" name="reorder_level" value="5"></label>
      <label>Photo <input type="file" name="photo" accept="image/*"></label>
      <button type="submit" class="btn btn-primary">Add product</button>
    </form>
  </main>
</body>
</html>