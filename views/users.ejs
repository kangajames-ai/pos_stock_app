<!DOCTYPE html>
<html>
<%- include('partials/head', { title: 'Users' }) %>
<body>
  <%- include('partials/header') %>
  <main>
    <%- include('partials/flash') %>
    <h2>Users</h2>
    <p class="subtitle">Everyone with access to this system.</p>
    <table>
      <tr>
        <th>Name</th>
        <th>Username</th>
        <th>Role</th>
        <th></th>
      </tr>
      <% users.forEach(function(user) { %>
        <tr>
          <td><%= user.full_name %></td>
          <td><%= user.username %></td>
          <td><%= user.role %></td>
          <td>
            <a href="/users/<%= user.user_id %>/edit"><i class="ti ti-edit"></i> Edit</a>
            <form action="/users/<%= user.user_id %>/delete" method="POST" style="display: inline;" onsubmit="return confirm('Delete this user? This can\'t be undone.');">
              <button type="submit" style="border: none; background: none; color: #A32D2D; cursor: pointer; padding: 0; font-size: 14px; margin-left: 10px;"><i class="ti ti-trash"></i> Delete</button>
            </form>
          </td>
        </tr>
      <% }); %>
    </table>
    <p style="margin-top: 20px;"><a href="/users/new" class="btn btn-primary"><i class="ti ti-plus"></i> Add a user</a></p>
  </main>
</body>
</html>